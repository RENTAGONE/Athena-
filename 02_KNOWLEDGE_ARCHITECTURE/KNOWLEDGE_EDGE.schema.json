{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athena.local/schemas/athena-storage-edge-v0.2.schema.json",
  "title": "ATHENA_STORAGE_EDGE_v0.2",
  "description": "Storage representation: id is an internal immutable UUID; code is optional and reserved for authored transfer links. Source/target are internal UUIDs.",
  "type": "object",
  "required": [
    "id",
    "relation_type",
    "source_id",
    "target_id",
    "status",
    "owner_discipline_id",
    "gating",
    "content_version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "code": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^ATH-XFER-[A-Z0-9-]+$"
    },
    "relation_type": {
      "enum": [
        "CONTAINS",
        "PART_OF",
        "PREREQUISITE_FOR",
        "SUPPORTS",
        "APPLIES_TO",
        "TRANSFER_TO",
        "RELATED_TO",
        "CONTRASTS_WITH",
        "ASSESSES",
        "EVIDENCES",
        "USES_RESOURCE",
        "DEVELOPS",
        "CONTRIBUTES_TO",
        "SUPERSEDES",
        "EXPLAINS",
        "ENABLES",
        "SHARED_FOUNDATION_FOR"
      ]
    },
    "source_id": {
      "type": "string",
      "format": "uuid"
    },
    "target_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "approved",
        "deprecated"
      ]
    },
    "strength": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "required",
        "recommended",
        "helpful",
        null
      ]
    },
    "gating": {
      "enum": [
        "none",
        "advisory",
        "hard"
      ]
    },
    "owner_discipline_id": {
      "type": "string",
      "pattern": "^ATH-DISC-[A-Z]+$"
    },
    "rationale": {
      "type": "string"
    },
    "hard_gate_justification": {
      "type": [
        "string",
        "null"
      ]
    },
    "transfer_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "conceptual",
        "procedural",
        "mathematical",
        "methodological",
        "tooling",
        "physical",
        "communication",
        "strategic",
        null
      ]
    },
    "transfer_distance": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "near",
        "intermediate",
        "far",
        null
      ]
    },
    "mechanism": {
      "type": [
        "string",
        "null"
      ]
    },
    "expected_benefit": {
      "type": [
        "string",
        "null"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "content_version": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "provenance": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "gating": {
            "const": "hard"
          }
        },
        "required": [
          "gating"
        ]
      },
      "then": {
        "properties": {
          "relation_type": {
            "const": "PREREQUISITE_FOR"
          },
          "strength": {
            "const": "required"
          },
          "hard_gate_justification": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    }
  ]
}
