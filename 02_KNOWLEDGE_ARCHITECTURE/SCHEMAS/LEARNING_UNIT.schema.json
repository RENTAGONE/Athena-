{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athena.local/schemas/athena-learning-unit.schema.json",
  "title": "ATHENA_LEARNING_UNIT",
  "description": "A coherent instructional grouping that connects objectives, concepts, practice, resources and assessment.",
  "type": "object",
  "required": [
    "id",
    "object_type",
    "title",
    "status",
    "discipline_ids",
    "objective_ids",
    "completion_criteria",
    "content_version",
    "owner_discipline_id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ATH-UNIT-[A-Z]+-[A-Z0-9-]+$"
    },
    "object_type": {
      "const": "learning_unit"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "approved",
        "deprecated",
        "archived"
      ]
    },
    "discipline_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "objective_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ATH-(DISC|DOM|FAM|SKILL|SUB|CON|OBJ|UNIT|RES|ASMT|PROJ|MICRO|XFER|EDGE)-[A-Z0-9-]+$"
      }
    },
    "concept_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ATH-(DISC|DOM|FAM|SKILL|SUB|CON|OBJ|UNIT|RES|ASMT|PROJ|MICRO|XFER|EDGE)-[A-Z0-9-]+$"
      }
    },
    "skill_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ATH-(DISC|DOM|FAM|SKILL|SUB|CON|OBJ|UNIT|RES|ASMT|PROJ|MICRO|XFER|EDGE)-[A-Z0-9-]+$"
      }
    },
    "prerequisite_unit_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ATH-(DISC|DOM|FAM|SKILL|SUB|CON|OBJ|UNIT|RES|ASMT|PROJ|MICRO|XFER|EDGE)-[A-Z0-9-]+$"
      }
    },
    "resource_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ATH-(DISC|DOM|FAM|SKILL|SUB|CON|OBJ|UNIT|RES|ASMT|PROJ|MICRO|XFER|EDGE)-[A-Z0-9-]+$"
      }
    },
    "practice_protocol_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assessment_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ATH-(DISC|DOM|FAM|SKILL|SUB|CON|OBJ|UNIT|RES|ASMT|PROJ|MICRO|XFER|EDGE)-[A-Z0-9-]+$"
      }
    },
    "estimated_effort_minutes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "sequence_rationale": {
      "type": "string"
    },
    "completion_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "content_version": {
      "type": "integer",
      "minimum": 1
    },
    "owner_discipline_id": {
      "type": "string",
      "pattern": "^ATH-DISC-[A-Z]+$"
    },
    "primary_domain_id": {
      "type": "string",
      "pattern": "^ATH-DOM-[A-Z]+-[A-Z0-9-]+$"
    },
    "domain_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ATH-DOM-[A-Z]+-[A-Z0-9-]+$"
      }
    }
  },
  "additionalProperties": false
}
