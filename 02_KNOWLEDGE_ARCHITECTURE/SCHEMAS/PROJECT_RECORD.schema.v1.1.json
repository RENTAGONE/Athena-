{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athena.local/schemas/athena-project-record.schema.v1.1.json",
  "title": "ATHENA_PROJECT_RECORD v1.1",
  "description": "Additive project-class discriminator and blueprint/module traceability. v1.0 records remain readable through migration defaults.",
  "type": "object",
  "required": [
    "id",
    "object_type",
    "title",
    "status",
    "goal",
    "discipline_ids",
    "deliverables",
    "acceptance_criteria",
    "content_version",
    "project_class",
    "blueprint_ref",
    "target_module_ids"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ATH-(PROJ|MILESTONE|PRACT|COMP)-[A-Z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "summary": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "approved",
        "deprecated",
        "archived"
      ]
    },
    "owner_discipline_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^ATH-DISC-[A-Z]+$"
    },
    "content_version": {
      "type": "integer",
      "minimum": 1
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_notes": {
      "type": "string"
    },
    "object_type": {
      "const": "project"
    },
    "goal": {
      "type": "string",
      "minLength": 5
    },
    "discipline_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ATH-DISC-[A-Z]+$"
      }
    },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "milestone_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "resource_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "safety_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "project_state": {
      "enum": [
        "proposed",
        "active",
        "paused",
        "completed",
        "archived"
      ]
    },
    "project_class": {
      "enum": [
        "personal_use",
        "product_business_foundation",
        "intrinsic_exploration"
      ]
    },
    "blueprint_ref": {
      "type": "string",
      "pattern": "^ATH-PROJ-(PERSONAL|PRODUCT|INTRINSIC)-[0-9]{3}$"
    },
    "target_module_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^BASE-[A-Z]+-[0-9]{3}$"
      }
    }
  },
  "additionalProperties": false
}