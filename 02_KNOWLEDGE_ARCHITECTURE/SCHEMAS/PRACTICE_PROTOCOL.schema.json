{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athena.local/schemas/athena-practice-protocol.schema.json",
  "title": "ATHENA_PRACTICE_PROTOCOL",
  "description": "",
  "type": "object",
  "required": [
    "id",
    "object_type",
    "title",
    "status",
    "owner_discipline_id",
    "target_ids",
    "steps",
    "content_version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ATH-PRACT-[A-Z0-9-]+$"
    },
    "object_type": {
      "const": "practice_protocol"
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "approved",
        "deprecated",
        "archived"
      ]
    },
    "owner_discipline_id": {
      "type": "string",
      "pattern": "^ATH-DISC-[A-Z]+$"
    },
    "target_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "dose": {
      "type": "object",
      "properties": {
        "duration_minutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "frequency": {
          "type": "string"
        },
        "sets_or_trials": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "equipment": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "environment": {
      "type": "string"
    },
    "safety_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "adaptations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "content_version": {
      "type": "integer",
      "minimum": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
