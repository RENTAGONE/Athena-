{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athena.local/schemas/athena-domain-record.schema.json",
  "title": "ATHENA_DOMAIN_RECORD",
  "description": "Canonical domain record; owner discipline must agree with its primary parent discipline.",
  "type": "object",
  "required": [
    "id",
    "object_type",
    "title",
    "description",
    "discipline_ids",
    "owner_discipline_id",
    "parent_id",
    "code",
    "status",
    "content_version",
    "review_state",
    "aliases",
    "source_basis",
    "existing_in_v0_1_seed"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ATH-DOM-[A-Z]+-[A-Z0-9-]+$"
    },
    "object_type": {
      "const": "domain"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "description": {
      "type": "string"
    },
    "discipline_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ATH-DISC-[A-Z]+$"
      }
    },
    "owner_discipline_id": {
      "type": "string",
      "pattern": "^ATH-DISC-[A-Z]+$"
    },
    "parent_id": {
      "type": "string",
      "pattern": "^ATH-DISC-[A-Z]+$"
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Z0-9-]+$"
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "approved",
        "deprecated",
        "archived"
      ]
    },
    "content_version": {
      "type": "integer",
      "minimum": 1
    },
    "review_state": {
      "enum": [
        "needs_review",
        "in_review",
        "reviewed",
        "approved",
        "blocked"
      ]
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_basis": {
      "type": "string"
    },
    "existing_in_v0_1_seed": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
