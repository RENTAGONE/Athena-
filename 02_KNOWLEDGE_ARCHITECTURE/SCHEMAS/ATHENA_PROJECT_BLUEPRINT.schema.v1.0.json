{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athena.local/schemas/athena-project-blueprint.schema.json",
  "title": "ATHENA_PROJECT_BLUEPRINT",
  "type": "object",
  "required": [
    "project_id",
    "title",
    "project_class",
    "goal",
    "driving_question",
    "disciplines",
    "target_module_ids",
    "milestones",
    "deliverables",
    "acceptance_criteria",
    "evidence_plan",
    "project_quality_rubric",
    "scope_variants",
    "safety_and_ethics",
    "completion_rule",
    "mastery_boundary",
    "review_state"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^ATH-PROJ-(PERSONAL|PRODUCT|INTRINSIC)-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "project_class": {
      "enum": [
        "personal_use",
        "product_business_foundation",
        "intrinsic_exploration"
      ]
    },
    "goal": {
      "type": "string",
      "minLength": 20
    },
    "driving_question": {
      "type": "string",
      "minLength": 10
    },
    "disciplines": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]+$"
      },
      "uniqueItems": true
    },
    "target_module_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^BASE-[A-Z]+-[0-9]{3}$"
      },
      "uniqueItems": true
    },
    "module_traceability": {
      "type": "array"
    },
    "assessment_alignment": {
      "type": "object"
    },
    "scope_and_design": {
      "type": "object"
    },
    "milestones": {
      "type": "array",
      "minItems": 4
    },
    "deliverables": {
      "type": "array",
      "minItems": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 3
    },
    "evidence_plan": {
      "type": "array",
      "minItems": 1
    },
    "project_quality_rubric": {
      "type": "object",
      "minProperties": 3
    },
    "scope_variants": {
      "type": "object"
    },
    "safety_and_ethics": {
      "type": "array"
    },
    "completion_rule": {
      "type": "string"
    },
    "transfer_rule": {
      "type": "string"
    },
    "mastery_boundary": {
      "type": "string"
    },
    "review_state": {
      "type": "string"
    }
  },
  "additionalProperties": true
}