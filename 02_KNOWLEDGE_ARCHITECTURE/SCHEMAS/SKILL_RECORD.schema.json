{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athena.local/schemas/athena-skill-record.schema.json",
  "title": "ATHENA_SKILL_RECORD",
  "description": "Canonical skill record. Skills describe demonstrable capabilities, not topics or resource collections. v0.2 adds explicit owner and canonical domain mapping; draft mappings are not approval.",
  "type": "object",
  "required": [
    "id",
    "object_type",
    "title",
    "status",
    "discipline_ids",
    "outcome_statement",
    "content_version",
    "owner_discipline_id",
    "primary_domain_id",
    "domain_ids",
    "mapping_status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ATH-SKILL-[A-Z]+-[A-Z0-9-]+$"
    },
    "object_type": {
      "const": "skill"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "summary": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "approved",
        "deprecated",
        "archived"
      ]
    },
    "discipline_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ATH-DISC-[A-Z]+$"
      }
    },
    "domain_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ATH-DOM-[A-Z]+-[A-Z0-9-]+$"
      }
    },
    "skill_family_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^ATH-FAM-[A-Z]+-[A-Z0-9-]+$"
    },
    "parent_skill_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "subskill_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ATH-(DISC|DOM|FAM|SKILL|SUB|CON|OBJ|UNIT|RES|ASMT|PROJ|MICRO|XFER|EDGE)-[A-Z0-9-]+$"
      }
    },
    "concept_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ATH-(DISC|DOM|FAM|SKILL|SUB|CON|OBJ|UNIT|RES|ASMT|PROJ|MICRO|XFER|EDGE)-[A-Z0-9-]+$"
      }
    },
    "objective_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ATH-(DISC|DOM|FAM|SKILL|SUB|CON|OBJ|UNIT|RES|ASMT|PROJ|MICRO|XFER|EDGE)-[A-Z0-9-]+$"
      }
    },
    "prerequisite_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ATH-(DISC|DOM|FAM|SKILL|SUB|CON|OBJ|UNIT|RES|ASMT|PROJ|MICRO|XFER|EDGE)-[A-Z0-9-]+$"
      }
    },
    "outcome_statement": {
      "type": "string"
    },
    "performance_contexts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "difficulty_dimensions": {
      "type": "object",
      "properties": {
        "complexity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "novelty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "independence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "precision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "constraints": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "consequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      },
      "additionalProperties": false
    },
    "evidence_types": {
      "type": "array",
      "items": {
        "enum": [
          "SELF_REPORT",
          "RETRIEVAL",
          "EXPLANATION",
          "PROBLEM_PERFORMANCE",
          "PRACTICAL_DEMONSTRATION",
          "PROJECT_ARTEFACT",
          "TRANSFER_PERFORMANCE",
          "EXTERNAL_VERIFICATION"
        ]
      }
    },
    "safety_class": {
      "enum": [
        "none",
        "low",
        "moderate",
        "high",
        "critical"
      ]
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "content_version": {
      "type": "integer",
      "minimum": 1
    },
    "review_notes": {
      "type": "string"
    },
    "owner_discipline_id": {
      "type": "string",
      "pattern": "^ATH-DISC-[A-Z]+$"
    },
    "primary_domain_id": {
      "type": "string",
      "pattern": "^ATH-DOM-[A-Z]+-[A-Z0-9-]+$"
    },
    "mapping_status": {
      "enum": [
        "draft_proposed_needs_review",
        "inherited_from_parent_skill_draft",
        "reviewed"
      ]
    }
  },
  "additionalProperties": false
}
