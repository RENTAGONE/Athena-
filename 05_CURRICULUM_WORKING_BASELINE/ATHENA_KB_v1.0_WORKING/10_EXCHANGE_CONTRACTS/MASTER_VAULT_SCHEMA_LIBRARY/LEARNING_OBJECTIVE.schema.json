{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athena.local/schemas/athena-learning-objective-v0.2.schema.json",
  "title": "ATHENA_LEARNING_OBJECTIVE_v0.2",
  "description": "",
  "type": "object",
  "required": [
    "id",
    "object_type",
    "title",
    "status",
    "discipline_ids",
    "owner_discipline_id",
    "content_version",
    "primary_outcome_class",
    "observable_action",
    "target_object",
    "conditions",
    "success_criteria",
    "assessment_methods"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ATH-OBJ-[A-Z0-9-]+$"
    },
    "object_type": {
      "const": "learning_objective"
    },
    "title": {
      "type": "string",
      "minLength": 8,
      "maxLength": 180
    },
    "summary": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "approved",
        "deprecated",
        "archived"
      ]
    },
    "discipline_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ATH-DISC-[A-Z]+$"
      }
    },
    "owner_discipline_id": {
      "type": "string",
      "pattern": "^ATH-DISC-[A-Z]+$"
    },
    "parent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "content_version": {
      "type": "integer",
      "minimum": 1
    },
    "primary_outcome_class": {
      "enum": [
        "RECALL",
        "EXPLAIN",
        "INTERPRET",
        "PROCEDURE",
        "SOLVE",
        "CREATE",
        "EVALUATE",
        "TRANSFER"
      ]
    },
    "observable_action": {
      "type": "string",
      "minLength": 2
    },
    "target_object": {
      "type": "string",
      "minLength": 2
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "assessment_methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "retrieval",
          "explanation",
          "problem_performance",
          "practical_demonstration",
          "project_artefact",
          "transfer_task",
          "external_verification"
        ]
      }
    },
    "evidence_dimensions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "ACCURACY",
          "EXPLANATION",
          "INDEPENDENCE",
          "TRANSFER",
          "RETENTION",
          "QUALITY",
          "SAFETY",
          "JUDGEMENT"
        ]
      }
    },
    "prerequisite_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "misconceptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_notes": {
      "type": "string"
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "primary_domain_id": {
      "type": "string",
      "pattern": "^ATH-DOM-[A-Z]+-[A-Z0-9-]+$"
    },
    "domain_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ATH-DOM-[A-Z]+-[A-Z0-9-]+$"
      }
    },
    "review_state": {
      "enum": [
        "needs_review",
        "in_review",
        "reviewed",
        "approved",
        "blocked"
      ]
    }
  },
  "additionalProperties": false
}
