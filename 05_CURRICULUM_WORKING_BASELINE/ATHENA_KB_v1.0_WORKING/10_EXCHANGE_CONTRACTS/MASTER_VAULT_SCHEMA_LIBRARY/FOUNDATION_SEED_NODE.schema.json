{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athena.local/schemas/foundation-seed-node-v0.2.schema.json",
  "title": "ATHENA_FOUNDATION_SEED_NODE_v0.2",
  "type": "object",
  "required": [
    "id",
    "object_type",
    "title",
    "status",
    "discipline_ids",
    "owner_discipline_id",
    "content_version",
    "record_stage"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ATH-(DOM|CON|OBJ)-[A-Z0-9-]+$"
    },
    "object_type": {
      "enum": [
        "domain",
        "concept",
        "learning_objective"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "summary": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "approved",
        "deprecated",
        "archived"
      ]
    },
    "discipline_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ATH-DISC-[A-Z]+$"
      }
    },
    "owner_discipline_id": {
      "type": "string",
      "pattern": "^ATH-DISC-[A-Z]+$"
    },
    "parent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "content_version": {
      "type": "integer",
      "minimum": 1
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "record_stage": {
      "enum": [
        "seed_record",
        "seed_stub",
        "domain_map_mirror"
      ]
    },
    "review_state": {
      "enum": [
        "needs_review",
        "in_review",
        "reviewed",
        "approved",
        "blocked"
      ]
    },
    "approval_blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
