{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athena.local/schemas/athena-milestone-record.schema.json",
  "title": "ATHENA_MILESTONE_RECORD",
  "description": "",
  "type": "object",
  "required": [
    "id",
    "object_type",
    "title",
    "status",
    "project_id",
    "acceptance_criteria",
    "content_version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ATH-(PROJ|MILESTONE|PRACT|COMP)-[A-Z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "summary": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "approved",
        "deprecated",
        "archived"
      ]
    },
    "owner_discipline_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^ATH-DISC-[A-Z]+$"
    },
    "content_version": {
      "type": "integer",
      "minimum": 1
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_notes": {
      "type": "string"
    },
    "object_type": {
      "const": "milestone"
    },
    "project_id": {
      "type": "string",
      "pattern": "^ATH-PROJ-[A-Z0-9-]+$"
    },
    "goal": {
      "type": "string"
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "depends_on_milestone_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "target_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "status_detail": {
      "enum": [
        "not_started",
        "in_progress",
        "blocked",
        "completed",
        "deferred"
      ]
    }
  },
  "additionalProperties": false
}
