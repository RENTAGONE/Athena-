{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athena.local/schemas/athena-knowledge-relationship-exchange-v0.2.schema.json",
  "title": "ATHENA_KNOWLEDGE_RELATIONSHIP_EXCHANGE_v0.2",
  "description": "Exchange representation: source_id and target_id carry stable ATHENA semantic codes. client_ref is a package-local correlation key. ATHENA resolves codes, allocates internal UUIDs and stores edges using KNOWLEDGE_EDGE.schema.json.",
  "type": "object",
  "required": [
    "client_ref",
    "source_id",
    "target_id",
    "relation_type",
    "status",
    "owner_discipline_id",
    "gating",
    "content_version"
  ],
  "properties": {
    "client_ref": {
      "type": "string",
      "minLength": 6
    },
    "source_id": {
      "type": "string",
      "pattern": "^ATH-(DISC|DOM|FAM|SKILL|SUB|CON|OBJ|UNIT|RES|ASMT|PROJ|MICRO|CTX|XFER)-[A-Z0-9-]+$"
    },
    "target_id": {
      "type": "string",
      "pattern": "^ATH-(DISC|DOM|FAM|SKILL|SUB|CON|OBJ|UNIT|RES|ASMT|PROJ|MICRO|CTX|XFER)-[A-Z0-9-]+$"
    },
    "relation_type": {
      "enum": [
        "CONTAINS",
        "PART_OF",
        "PREREQUISITE_FOR",
        "SUPPORTS",
        "APPLIES_TO",
        "TRANSFER_TO",
        "RELATED_TO",
        "CONTRASTS_WITH",
        "ASSESSES",
        "EVIDENCES",
        "USES_RESOURCE",
        "DEVELOPS",
        "CONTRIBUTES_TO",
        "SUPERSEDES",
        "EXPLAINS",
        "ENABLES",
        "SHARED_FOUNDATION_FOR"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "approved",
        "deprecated"
      ]
    },
    "owner_discipline_id": {
      "type": "string",
      "pattern": "^ATH-DISC-[A-Z]+$"
    },
    "strength": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "required",
        "recommended",
        "helpful",
        null
      ]
    },
    "gating": {
      "enum": [
        "none",
        "advisory",
        "hard"
      ]
    },
    "rationale": {
      "type": "string"
    },
    "hard_gate_justification": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_by": {
      "type": "string"
    },
    "content_version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "gating": {
            "const": "hard"
          }
        },
        "required": [
          "gating"
        ]
      },
      "then": {
        "properties": {
          "relation_type": {
            "const": "PREREQUISITE_FOR"
          },
          "strength": {
            "const": "required"
          },
          "hard_gate_justification": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    }
  ]
}
