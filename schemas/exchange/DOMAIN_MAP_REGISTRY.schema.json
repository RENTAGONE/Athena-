{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athena.local/schemas/domain-map-registry-v0.3.schema.json",
  "title": "ATHENA_DOMAIN_MAP_REGISTRY_v0.3",
  "type": "object",
  "required": [
    "schema_version",
    "registry_type",
    "status",
    "discipline_registry_version",
    "counts",
    "domains",
    "skill_families"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3.0"
    },
    "registry_type": {
      "const": "domain_and_family_map"
    },
    "status": {
      "enum": [
        "draft_for_review",
        "approved"
      ]
    },
    "discipline_registry_version": {
      "type": "string"
    },
    "counts": {
      "type": "object",
      "required": [
        "disciplines",
        "domains",
        "skill_families",
        "total_domain_and_family_records"
      ],
      "properties": {
        "disciplines": {
          "const": 18
        },
        "domains": {
          "type": "integer",
          "minimum": 1
        },
        "skill_families": {
          "type": "integer",
          "minimum": 0
        },
        "total_domain_and_family_records": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "domains": {
      "type": "array",
      "items": {
        "$ref": "https://athena.local/schemas/athena-domain-record.schema.json"
      }
    },
    "skill_families": {
      "type": "array",
      "items": {
        "$ref": "https://athena.local/schemas/athena-skill-family-record.schema.json"
      }
    },
    "validation_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
