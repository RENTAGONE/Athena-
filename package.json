{
  "name": "athena-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ATHENA: local-first, phone-first capability and knowledge system. Scaffold v0.1 (domain core verified offline; UI, Dexie, Ajv, PWA and CI unrun).",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build:validators": "node tools/build-validators.mjs",
    "predev": "npm run build:validators",
    "dev": "vite",
    "prebuild": "npm run build:validators",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "test:ajv": "VALIDATOR=ajv node --test \"tests/*.test.ts\"",
    "test:dexie": "node --test \"tests/dexie/*.test.ts\"",
    "test:e2e": "playwright test",
    "validate:pack": "VALIDATOR=ajv node tools/validate-pack.ts",
    "verify": "npm run typecheck && npm run test && npm run test:ajv && npm run test:dexie && npm run validate:pack && npm run build"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.0.0",
    "@fontsource/inter": "^5.0.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.0.0",
    "dexie": "^4.0.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.76.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1",
    "fake-indexeddb": "^6.0.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0"
  }
}
